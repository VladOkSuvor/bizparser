# Скопируй в .env и подставь свой контакт — это требование usage policy OSM.
USER_AGENT=bizparser/0.1 (lead research; contact: you@example.com)

DB_URL=sqlite:///businesses.db
# DB_URL=postgresql+psycopg://user:pass@localhost/leads

OVERPASS_URL=https://overpass-api.de/api/interpreter
# Зеркала, если основной перегружен:
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
# OVERPASS_URL=https://overpass.private.coffee/api/interpreter

NOMINATIM_URL=https://nominatim.openstreetmap.org

# Паузы между запросами, секунды. Уменьшать — плохая идея.
NOMINATIM_DELAY=1.2
OVERPASS_DELAY=3.0
SITE_DELAY=1.0
DDG_DELAY=6.0

HTTP_TIMEOUT=30
RESPECT_ROBOTS=1
PHONE_REGION=UA

ENRICH_CONCURRENCY=8
STALE_DAYS=90
DEDUPE_RADIUS_M=30
DEDUPE_THRESHOLD=0.84
RERUN_AFTER_DAYS=21

# Google Places (New) — опционально и платно. Пусто = команда `google-places`
# выключена, остальной пайплайн её вообще не касается.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MONTHLY_CAP=500

# Google Sheets — общий вид на лиды для команды, бесплатно. Пусто = команда
# `sheets-sync` выключена. Как получить оба значения — см. README.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
